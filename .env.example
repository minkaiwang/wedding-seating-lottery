# Copy to `.env` for local development (PowerShell: Copy-Item .env.example .env)
# SQLite path is relative to `prisma/schema.prisma` → creates `prisma/dev.db`
# First-time cloud sync: npm run db:init   (optional UI: npm run db:studio)

DATABASE_URL="file:./dev.db"

# Public deployment origin used by metadata, sitemap, robots, and structured data.
# Keep localhost for local work; set an HTTPS origin only after you own the domain.
# NEXT_PUBLIC_SITE_URL=https://example.com

# --- Optional: lottery bridge / live sync (seating app) ---
# Full URL to log-lottery “人员名单” page. Default works with `npm run dev:stack`.
# NEXT_PUBLIC_LOTTERY_IMPORT_URL=http://localhost:6719/log-lottery/config/person/all
# Note: NEXT_PUBLIC_* is baked at build time — run `npm run build` after changing.

# --- Optional: cloud sync (/sync) ---
# Local dev: JWT_SECRET can be unset (dev fallback). Production: random string, 32+ chars.
# JWT_SECRET=
# Admin password after `npm run db:seed`. Development may use the local default if unset;
# production requires a non-default password of at least 12 characters.
# ADMIN_PASSWORD=

# --- Optional: cookies behind HTTP reverse proxy ---
# COOKIE_SECURE=1
# COOKIE_INSECURE=1

# Lottery-side env → see `log-lottery/.env.example` (VITE_WEDDING_SEATING_ORIGINS, hub URLs)
