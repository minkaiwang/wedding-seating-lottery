# Copy to `.env` for local development.
# SQLite file path is relative to `prisma/schema.prisma` → creates `prisma/dev.db`.
# First-time setup: npm run db:init   (optional UI: npm run db:studio)

DATABASE_URL="file:./dev.db"

# Optional: admin password for sync login after `npm run db:seed` (defaults if unset; use 10+ chars if you set it)
# ADMIN_PASSWORD=

# Optional: override lottery “人员名单” URL (default: localhost:6719 …)
# NEXT_PUBLIC_LOTTERY_IMPORT_URL=http://localhost:6719/log-lottery/config/person/all

# Production: required — random string, 32+ characters
# JWT_SECRET=
