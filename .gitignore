# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# log-lottery production build (may embed old brand strings until rebuilt)
/log-lottery/dist/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!log-lottery/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma local DB
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db
/prisma/*.db-journal

# Guest / plan exports (never commit real wedding data)
*.xlsx
*.xls
*.csv
!**/template*.xlsx
wedding-seating-plan*.json
*-export.json
*-backup.json

# Local media uploads (wedding photos, lottery assets)
/log-lottery/images/*
!/log-lottery/images/.gitkeep
/log-lottery/videos/*
!/log-lottery/videos/.gitkeep
/log-lottery/data/*
!/log-lottery/data/.gitkeep

# OS / editor
Thumbs.db
